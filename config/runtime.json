{
  "mut_model": "deepseek-chat",
  "env_model": "gpt-5.4-mini",
  "api": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY"
  },
  "concurrency": {
    "interact": 15,
    "eval": 10
  },
  "vllm": {
    "enabled": false,
    "base_url": "http://localhost:8000/v1"
  },
  "runtime_settings": {
    "max_turns": 60,
    "hint_counts": true
  }
}
